NODE_ENV=production
PORT=3000

# Isi dengan API key OpenRouter yang valid
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL_FAST=deepseek/deepseek-chat
OPENROUTER_MODEL_HEAVY=deepseek/deepseek-v3.2
OPENROUTER_MODEL_FREE=openrouter/free
OPENROUTER_MODEL_REPORT_RECOMMENDATION=openrouter/free
OPENROUTER_MODEL_QUICK_SUGGEST=openrouter/free
OPENROUTER_TIMEOUT_FAST_MS=12000
OPENROUTER_TIMEOUT_HEAVY_MS=25000

# Supabase (WAJIB untuk recurring scheduler, auto-run log, dan write data server-side)
# Ambil dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Play IAP verification untuk endpoint /api/iap/google/verify
GOOGLE_PLAY_PACKAGE_NAME=com.peachstudiotech.dompetku
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Alternatif: pakai satu JSON utuh dari service account Google Cloud.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# Optional kalau ingin override publishable/anon key untuk validasi session Supabase di backend.
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Pisahkan dengan koma. Capacitor Android dapat memakai http://localhost
# atau https://localhost, sedangkan iOS memakai capacitor://localhost.
# Jika punya domain frontend, tambahkan tanpa menghapus origin mobile ini.
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,http://localhost:3000,https://localhost:3000,capacitor://localhost
